<?xml version="1.0" encoding="utf-8"?>
<!-- Enforce TLS-only connections and reject user-installed CA certificates (MITM prevention) -->
<network-security-config>
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
