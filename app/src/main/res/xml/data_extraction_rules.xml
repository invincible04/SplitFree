<?xml version="1.0" encoding="utf-8"?>
<!-- R4: Block cloud backup and D2D transfer of all app data (defense-in-depth alongside allowBackup=false) -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" path="." />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" path="." />
    </device-transfer>
</data-extraction-rules>
